+    def get_residual_after_attn(self, token_ids: List[int], layer_idx: int) -> np.ndarray:
+        """Hidden states [seq, dim] after attention (+ residual) at ``layer_idx``, before MLP.
+
+        Used by ROME to read MLP keys at an arbitrary token position (paper: subject
+        last token) without confusing gate rows with keys.
+        """
+        if not self.is_available():
+            raise RuntimeError("Forward pass not available")
+        if layer_idx < 0 or layer_idx >= len(self.layers):
+            raise ValueError(f"Layer {layer_idx} out of range")
+        seq = list(token_ids)[: self.config.max_seq_len]
+        x = self.token_embd[np.array(seq)]
+        positions = np.arange(len(seq), dtype=np.float32)
+        for i, layer in enumerate(self.layers):
+            if i == layer_idx:
+                return self._attention_block(x, layer, positions)
+            x = self._apply_layer(x, layer, positions)
+        raise RuntimeError("unreachable")
+
+    def _attention_block(self, x: np.ndarray, layer: LayerTensors, positions: np.ndarray) -> np.ndarray:
+        """Attention sublayer only; returns x + attn_out (pre-MLP residual)."""
+        cfg = self.config
+        seq_len, dim = x.shape
+        attn_input = self._rms_norm(x, layer.attn_norm) if layer.attn_norm is not None else x
+        q = attn_input @ layer.attn_q.T
+        k = attn_input @ layer.attn_k.T
+        v = attn_input @ layer.attn_v.T
+        q = q.reshape(seq_len, cfg.n_heads, cfg.head_dim).transpose(1, 0, 2)
+        k = k.reshape(seq_len, cfg.n_kv_heads, cfg.head_dim).transpose(1, 0, 2)
+        v = v.reshape(seq_len, cfg.n_kv_heads, cfg.head_dim).transpose(1, 0, 2)
+        q = self._apply_rope(q, positions)
+        k = self._apply_rope(k, positions)
+        if cfg.n_kv_heads < cfg.n_heads:
+            n_rep = cfg.n_heads // cfg.n_kv_heads
+            k = np.repeat(k, n_rep, axis=0)
+            v = np.repeat(v, n_rep, axis=0)
+        scale = 1.0 / np.sqrt(float(cfg.head_dim))
+        scores = (q.astype(np.float64) @ k.astype(np.float64).transpose(0, 2, 1)) * scale
+        mask = np.triu(np.ones((seq_len, seq_len), dtype=bool), k=1)
+        scores[:, mask] = -1e9
+        scores = scores - scores.max(axis=-1, keepdims=True)
+        attn = np.exp(scores)
+        attn = attn / attn.sum(axis=-1, keepdims=True)
+        attn_out = (attn @ v.astype(np.float64)).astype(np.float32)
+        attn_out = attn_out.transpose(1, 0, 2).reshape(seq_len, dim)
+        attn_out = attn_out @ layer.attn_output.T
+        return x + attn_out
+
+    def mlp_keys_from_residual(self, residual: np.ndarray, layer_idx: int) -> np.ndarray:
+        """Gated MLP activations h = SiLU(W_gate x) * (W_up x) for each position.
+
+        ``residual`` is the pre-MLP stream [seq, dim] (post-attention residual).
+        Returns [seq, hidden_dim].
+        """
+        layer = self.layers[layer_idx]
+        if layer.ffn_gate is None or layer.ffn_up is None:
+            raise ValueError("gated MLP required")
+        ffn_input = self._rms_norm(residual, layer.ffn_norm) if layer.ffn_norm is not None else residual
+        gate = self._silu(ffn_input @ layer.ffn_gate.T)
+        up = ffn_input @ layer.ffn_up.T
+        return (gate * up).astype(np.float32)
 
